# devdrawer AI (Groq). Copy to .env.local for local dev, or paste into Vercel → Settings → Environment Variables.
# Add 1 to 5 keys. Requests rotate across them and fail over when one is rate-limited.
GROQ_API_KEY_1=gsk_your_first_key
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Optional
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
AI_RATE_LIMIT=20
