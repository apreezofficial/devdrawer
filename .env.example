# devdrawer AI: Gemini primary, Groq fallback.
# Copy to .env.local, or set these in Vercel → Settings → Environment Variables.
# Gemini is attempted only when a Gemini key is configured. Leave blank to use Groq directly.
# GOOGLE_API_KEY is also accepted as an alternative to GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq fallback (also works on its own without Gemini).
# Add 1 to 5 keys. Requests rotate across them and fail over when one is rate-limited.
GROQ_API_KEY_1=gsk_your_first_key
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Optional
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
AI_RATE_LIMIT=20
